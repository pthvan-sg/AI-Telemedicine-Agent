  "rules": [
    {"a": "class:anticoagulant", "b": "class:nsaid", "severity": "major",
     "message": "Anticoagulant with an NSAID raises bleeding risk. Avoid the combination where possible and consider a non-NSAID analgesic."},
    {"a": "class:anticoagulant", "b": "class:ssri_snri", "severity": "moderate",
     "message": "SSRIs and SNRIs can add to bleeding risk when taken with an anticoagulant. Monitor."},
    {"a": "class:anticoagulant", "b": "class:penicillin", "severity": "moderate",
     "message": "Some antibiotics can raise INR in patients on warfarin. Monitor INR after starting."},
    {"a": "class:triptan", "b": "class:maoi", "severity": "contraindicated",
     "message": "Triptan with an MAOI, or within 2 weeks of stopping one, is contraindicated."},
    {"a": "class:triptan", "b": "class:ergot", "severity": "contraindicated",
     "message": "Triptan with ergot derivatives (within 24 hours of each other) risks prolonged vasospasm. Contraindicated."},
    {"a": "class:triptan", "b": "class:ssri_snri", "severity": "moderate",
     "message": "Triptan with an SSRI or SNRI: serotonin syndrome has been reported, though rarely. Counsel on symptoms and monitor."},
    {"a": "class:ssri_snri", "b": "drug:tramadol", "severity": "major",
     "message": "SSRI or SNRI with tramadol raises the risk of serotonin syndrome and seizures."},
    {"a": "class:ssri_snri", "b": "class:nsaid", "severity": "moderate",
     "message": "SSRI or SNRI with an NSAID increases the risk of GI bleeding."},
    {"a": "class:ace_inhibitor", "b": "class:nsaid", "severity": "moderate",
     "message": "NSAIDs can blunt ACE inhibitor effect and add to kidney injury risk, especially with a diuretic."},
    {"a": "class:ace_inhibitor", "b": "class:potassium_sparing", "severity": "moderate",
     "message": "ACE inhibitor with a potassium-sparing diuretic raises hyperkalemia risk. Monitor potassium and kidney function."},
    {"a": "class:nitrate", "b": "class:pde5_inhibitor", "severity": "contraindicated",
     "message": "Nitrate with a PDE5 inhibitor can cause severe hypotension. Contraindicated."},
    {"a": "drug:simvastatin", "b": "drug:clarithromycin", "severity": "contraindicated",
     "message": "Clarithromycin strongly inhibits CYP3A4 and raises simvastatin levels (rhabdomyolysis risk). Contraindicated."},
    {"a": "drug:methotrexate", "b": "class:trimethoprim_containing", "severity": "major",
     "message": "Trimethoprim with methotrexate raises the risk of bone marrow suppression."},
    {"a": "drug:clopidogrel", "b": "drug:omeprazole", "severity": "moderate",
     "message": "Omeprazole can reduce clopidogrel activation (CYP2C19). Consider an alternative PPI."},
    {"a": "drug:ibuprofen", "b": "drug:aspirin", "severity": "moderate",
     "message": "Ibuprofen can interfere with the antiplatelet effect of low-dose aspirin and adds GI bleeding risk."}
